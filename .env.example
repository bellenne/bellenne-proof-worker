# Same-host BellenneOne network: http://proof:8000
# Remote Core via gateway: https://bellenne.example/proof
# Docker Desktop via the host gateway: http://host.docker.internal:17863/proof
PROOF_CORE_URL=http://proof:8000
# Generate a separate Worker token in the Proof Core Workers page.
PROOF_WORKER_TOKEN=
PROOF_WORKER_NAME=production-01
WORKER_DATA_PATH=/data
WORKER_OUTPUT_PATH=/output
WORKER_SOURCE_ROOTS=["/sources/main"]
# Listen socket is bootstrap infrastructure; runtime processing settings come from Core UI.
WORKER_LISTEN_HOST=0.0.0.0
WORKER_LISTEN_PORT=8090
LOG_LEVEL=INFO
HEARTBEAT_INTERVAL=30
POLL_INTERVAL=5
HTTP_TIMEOUT=30
RETRY_INITIAL_SECONDS=1
RETRY_MAX_SECONDS=30
STORAGE_RETRY_LIMIT=5
FILE_NOT_FOUND_RETRY_LIMIT=0
HEALTH_INTERVAL=5
HEALTH_MAX_AGE=90
VIPS_CONCURRENCY=2
VIPS_CACHE_MEMORY_MB=128
# Host/Docker configuration only. Worker needs read/write access to create the next revision.
# Windows example: D:/Production/Artworks
# Linux/NAS example: /mnt/production
SOURCE_MAIN_HOST_PATH=
